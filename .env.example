# VORTE PRO - environment variables.
# Copy to .env and fill in. Names only here - NEVER commit real values.
# (Comments are on their own lines on purpose: some hosts/Docker env-files do not strip inline comments.)

# ---- Bot ----
BOT_NAME=VORTE PRO
# Extra default prefix. The prefixes . ! ? $ % & * always work as well.# Command prefix (same rules as Queen Anita):  .  = only "."   ·   .!*  = each of . ! * works   ·   all = any symbol, or none.
# Owner can change it live with  .prefix <value>  and undo with  .prefix reset
PREFIX=.
PORT=20202

# ---- Owner(s): country code + number, digits only ----
OWNER_1=
OWNER_2=

# ---- WhatsApp authentication ----
# Paste the whole SESSION_ID (VORTE_PRO~...) from the VORTE PRO Session ID Generator website.
SESSION_ID=
# If SESSION_ID is empty/invalid the bot asks for it in the console, or reads a session.txt file next to index.js
# (SESSION_FILE=/path/to/file to use another location). Set SESSION_PROMPT=false to disable.
# SESSION_PROMPT=false
# Local testing only: print a QR in the terminal when no SESSION_ID is set (default off).
# ENABLE_QR=true
# Optional: point at a persistent disk. Default is ./storage/session
SESSION_FOLDER=

# ---- AI providers (each optional; a missing one only disables its own features) ----
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# ---- Data APIs ----
YOUTUBE_API_KEY=
# No longer used by .imdb (that now uses TMDB below) - kept only if something else needs it.
IMDB_API_KEY=
# TMDB key, used by .imdb/.movie (search+details) - free at themoviedb.org
TMDB_API_KEY=
# Region for "where to watch" results, e.g. US GB TZ
TMDB_REGION=US
# Used by .randommovie and .randomtv
RAPIDAPI_KEY=

# ---- TikTok / Instagram (official developer credentials) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# ---- Security switches (leave off unless you know you need them) ----
# true enables the owner-only .sudo/.eval code-execution command (RISKY).
ENABLE_EVAL=false
# true serves the login QR at /qr over HTTP. Prefer the terminal QR.
ENABLE_QR_PAGE=false

# ---- Pairing-site deployment ONLY (do NOT set on a normal bot deployment) ----
# SESSION_GENERATOR_ONLY=true

# --- Downloader (yt-dlp) host options — all optional ---
# YTDLP_COOKIES=/home/container/cookies.json   # optional: if unset, cookies.json or cookies.txt in the bot folder is used automatically
# YTDLP_PROXY=http://user:pass@host:port      # route downloads through a proxy
# YTDLP_JS_RUNTIME=node                       # JS runtime for YouTube extraction (default node); "off" disables
# YTDLP_PATH=/path/to/yt-dlp                  # use your own yt-dlp binary instead of auto-download

# --- AntiDelete (recovered messages are sent to OWNER_1 / OWNER_2 inboxes) — all optional ---
# ANTIDELETE_CACHE_MINUTES=1440   # how long the BOT keeps a temporary copy so it can recover a deleted message/media (default 24 h)
# ANTIDELETE_MAX_MEDIA_MB=        # NO limit by default: media of any size is recovered. Set a number only if the host disk is tiny
# ANTIDELETE_MAX_TOTAL_MB=2048    # cap for all kept media together on disk (oldest dropped first, never the newest). 0 = no cap
# TZ=Africa/Dar_es_Salaam         # timezone used for the time shown in recovered-message notices

# --- Group status (.tostatusgroup / .togroupstatus) — optional ---
# GROUP_STATUS_FIELD=v1          # use the older "groupStatusMessage" field if your WhatsApp version doesn't show the default (V2) one

# --- Session ID site — all optional ---
# BOT_DOWNLOAD_URL=https://github.com/<you>/<repo>/releases/latest/download/VORTE-PRO.zip   # used by "Download bot file" when files/VORTE-PRO.zip is not uploaded
# PAIRING_COOLDOWN_MS=5000       # minimum gap between pairing-code requests for the same number
# PAIRING_EXPIRE_MS=600000       # an unfinished pairing is cleaned up (and counted as failed) after this long

# --- Downloads (yt-dlp / ffmpeg) — all optional ---
# ffmpeg + ffprobe come bundled from npm (@ffmpeg-installer/ffmpeg, @ffprobe-installer/ffprobe), or from the host if it has them.
# They join the separate picture/sound streams YouTube, Instagram and TikTok often serve, and convert audio to mp3.
# FFMPEG_PATH=/folder/with/ffmpeg-and-ffprobe   # use your own copy
# FFMPEG_DISABLE=true                           # never use ffmpeg (then only single-stream videos and m4a audio work)
# DOWNLOAD_PREWARM=false                        # don't fetch yt-dlp/ffmpeg at startup (they are fetched on first use instead)
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=mweb   # advanced: pass --extractor-args to yt-dlp
# Not sure why a link fails?  Send the bot  .dltest <link>  (owner only).

# --- Menu (all optional) ---
# MENU_OWNER_POLL=false           # the bot's own account (owner on the paired number) gets the menu as a poll, because WhatsApp
#                                 # won't let an account press buttons on its own messages. false = link buttons instead
# MENU_WRAP=viewonce              # send the button menu in the older viewOnceMessage envelope instead of directly (only if buttons don't show)
# SSWEB_TIMEOUT_MS=45000          # .ssweb: how long to wait for each screenshot service


# ---- Hardening (all optional; safe defaults) ----
# AI_USER_LIMIT_PER_HOUR=10        # @bot AI replies per person per hour (the owner is unlimited)
# MAX_PAIRINGS=5                   # pairing-site: pairings in progress at the same time
# PAIRING_MAX_PER_IP_HOUR=10       # pairing-site: code requests per visitor (IP) per hour
# PAIRING_REPLACE_AFTER_MS=60000   # pairing-site: another visitor may replace a waiting attempt only after this long
# TRUST_PROXY=1                    # number of proxies in front of the site (0 if exposed directly); makes the per-IP limit see the real visitor
# BOT_STATS_LOG=true               # one "[stats] rss=… heap=…" log line per minute (set false to silence)
# ENABLE_QR_PAGE=false             # the /qr page only exists when this is exactly "true" (the QR is a login credential)
# YTDLP_COOKIES=/path/outside/the/repo/cookies.json   # YouTube cookies: keep them OUTSIDE the repo and use a throwaway Google account
